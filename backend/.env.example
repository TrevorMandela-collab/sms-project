PORT=4000
JWT_SECRET=replace-this-with-a-long-random-string

# Postgres connection string — required. Data will NOT persist without this.
# Get a free one from Render (New > PostgreSQL), Neon, or Supabase, then
# paste the connection string it gives you here (and in Render's own
# environment variables for the deployed service — this file is just a
# local template, it isn't read in production).
DATABASE_URL=postgres://user:password@host:5432/dbname
