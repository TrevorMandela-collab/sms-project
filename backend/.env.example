PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_SEED_PASSWORD=
FRONTEND_URL=http://localhost:5500
TRUST_PROXY_HOPS=0
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Required in production. Without it, local
# development uses SQLite at backend/data/sms.sqlite.
# Get a hosted connection string from Render, Neon, or Supabase and set it
# in production environment variables.
# DATABASE_URL=postgres://user:password@host:5432/dbname
SQLITE_PATH=./data/sms.sqlite

# Production should set FRONTEND_URL to the HTTPS origin of the deployed UI.
# Multiple allowed origins can be comma-separated.
