{
  "name": "sms-backend",
  "version": "1.0.0",
  "description": "Express backend for the School Management System — auth with roles + REST API for all modules",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node utils/seed.js",
    "db:migrate": "node utils/migrate.js",
    "test": "node test/database.js && node test/fresh-migrations.js && node test/smoke.js",
    "test:postgres": "node test/database.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  }
}
